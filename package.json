{
  "name": "mon-budget",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Mon Budget — suivi de comptes personnel par enveloppes, 100 % local",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:tout": "node --test \"tests/unit/*.test.js\" && node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "build:fichier-unique": "node tools/build-single.mjs",
    "pwa": "node tools/pwa.mjs",
    "pwa:icones": "node tools/make-pwa-icons.mjs",
    "commentaires": "node tools/commentaires.mjs",
    "publier": "node tools/publier.mjs",
    "android:preparer": "node tools/android.mjs preparer",
    "apk": "node tools/android.mjs apk"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=22"
  }
}
